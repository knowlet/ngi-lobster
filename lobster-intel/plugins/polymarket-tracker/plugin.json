{
  "id": "polymarket-tracker",
  "name": "Polymarket Tracker",
  "version": "0.1.0",
  "type": "ingest",
  "entrypoints": {
    "ingest": "plugin.py:ingest"
  },
  "capabilities": [],
  "tracker": {
    "source_family": "prediction_market",
    "default_source_type": "prediction_market",
    "replayable": true,
    "state_mode": "cursor_json",
    "follow_up_queues": []
  },
  "required_env": ["POLYMARKET_MARKETS_JSON"],
  "recommended_schedule": "every 5m",
  "produces": [
    "evidence.prediction_market_snapshot"
  ],
  "notes": "Silent ingest only. Provide POLYMARKET_MARKETS_JSON as a JSON array of market ids or slugs."
}
