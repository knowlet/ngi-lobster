{
  "name": "@knowlet/openclaw-ngi-lobster",
  "version": "0.1.0",
  "private": true,
  "description": "NGI Lobster native OpenClaw plugin wrapper",
  "type": "module",
  "scripts": {
    "test:dispatcher-cut": "PYTHONPATH=lobster-intel/packages/lobster-core:lobster-intel/packages/lobster-delivery:lobster-intel/packages/lobster-ingest:lobster-intel/packages/lobster-plugins:lobster-intel/packages/lobster-runtime ./.venv/bin/python -m pytest lobster-intel/tests/test_dispatcher_artifact_writer.py lobster-intel/tests/test_dispatcher_acceptance_cli.py lobster-intel/tests/test_runtime_contract_bundle.py lobster-intel/tests/test_runtime_spine_dispatcher_path.py -q",
    "test:p0-cut": "npm run test:dispatcher-cut && npm run test:e2e-bundle-cut",
    "test:staging-cut": "npm run test:p0-cut && npm run test:latest-ngi-cut && npm run test:ops-health-cut && npm run test:live-sync-cut",
    "test:latest-ngi-cut": "./.venv/bin/python -m pytest lobster-intel/tests/test_verify_latest_ngi_contract_cli.py -q",
    "refresh:latest-ngi-live": "PYTHONPATH=lobster-intel/packages/lobster-core:lobster-intel/packages/lobster-delivery:lobster-intel/packages/lobster-ingest:lobster-intel/packages/lobster-plugins:lobster-intel/packages/lobster-runtime ./.venv/bin/python legacy/intelligence-model/run_ngi_monitor.py",
    "repair:latest-ngi-contract": "./.venv/bin/python lobster-intel/scripts/repair_latest_ngi_contract.py",
    "test:e2e-bundle-cut": "PYTHONPATH=lobster-intel/packages/lobster-core:lobster-intel/packages/lobster-delivery:lobster-intel/packages/lobster-ingest:lobster-intel/packages/lobster-plugins:lobster-intel/packages/lobster-runtime ./.venv/bin/python -m pytest lobster-intel/tests/test_dispatcher_e2e_bundle.py lobster-intel/tests/test_verify_alert_contract_bundle_cli.py -q",
    "test:ops-health-cut": "PYTHONPATH=lobster-intel/scripts ./.venv/bin/python -m pytest lobster-intel/tests/test_verify_runtime_ops_health.py -q",
    "test:live-sync-cut": "PYTHONPATH=lobster-intel/scripts ./.venv/bin/python -m pytest lobster-intel/tests/test_build_live_progress_sync_payload.py -q",
    "check:ops-health-live": "./.venv/bin/python lobster-intel/scripts/verify_runtime_ops_health.py /Users/knowlet/.openclaw/workspace/shared-projects/twse-close-report/STATE.yaml /Users/knowlet/.openclaw/workspace/intelligence_store.sqlite /Users/knowlet/.openclaw/workspace/shared-projects/intelligence-model/latest_ngi.json ./lobster-intel/data/runtime/sources/polymarket-tracker/latest.json",
    "build:live-sync-payload": "./.venv/bin/python lobster-intel/scripts/build_live_progress_sync_payload.py /Users/knowlet/.openclaw/workspace/shared-projects/twse-close-report/STATE.yaml /Users/knowlet/.openclaw/workspace/intelligence_store.sqlite /Users/knowlet/.openclaw/workspace/shared-projects/intelligence-model/latest_ngi.json"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  }
}
