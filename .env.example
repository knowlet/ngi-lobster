# Copy this to a private .env and fill in your real values.
# Do not commit secrets.

# Firehose credentials for external ingestion / setup scripts.
FIREHOSE_TAP_TOKEN=fh_xxx
FIREHOSE_MANAGEMENT_KEY=fhm_xxx

# Optional local path override ideas for future productization.
# Current legacy NGI code still expects a local events file under:
# ~/.openclaw/workspace/shared-projects/firehose-daemon/events.jsonl
FIREHOSE_EVENTS_PATH=
