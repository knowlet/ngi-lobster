{
  "id": "official-statements-tracker",
  "name": "Official Statements Tracker",
  "version": "0.1.0",
  "type": "ingest",
  "entrypoints": {
    "ingest": "plugin.py:ingest"
  },
  "capabilities": [],
  "tracker": {
    "source_family": "rss_feed",
    "default_source_type": "official_statement",
    "replayable": true,
    "state_mode": "cursor_json",
    "follow_up_queues": []
  },
  "required_env": ["OFFICIAL_STATEMENTS_FEEDS_JSON"],
  "recommended_schedule": "every 15m",
  "produces": [
    "evidence.official_statement"
  ],
  "notes": "Silent ingest only. Provide OFFICIAL_STATEMENTS_FEEDS_JSON as a JSON array of feed definitions."
}
